# Server & Database
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./dec_rag.db
DEV_BYPASS_AUTH=true

# Decision Judge Defaults (clef | openrouter_jev | openrouter_luna | openai_luna)
DEFAULT_JUDGE=openrouter_jev
DECISION_CONCURRENCY=8
DECISION_TIMEOUT_SECONDS=60.0
DECISION_MAX_RETRIES=3

# 1. Colab Cloudflare Clef-Flash 9B (/v1/systemone)
CLEF_API_URL=
CLEF_API_KEY=
CLEF_MODEL=Cloudflare/clef-flash

# 2. OpenRouter Decisions API (/api/alpha/decisions)
OPENROUTER_API_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
OPENROUTER_LUNA_MODEL=openai/gpt-6-luna-decisions

# 3. OpenAI Direct Decisions API (/v1/decisions)
OPENAI_DECISIONS_API_URL=https://api.openai.com/v1/decisions
OPENAI_API_KEY=
OPENAI_LUNA_MODEL=gpt-6-luna

# Stage 4 Grounded Answer Generator (App. C.1, temperature=0.0)
# For OpenAI: GENERATOR_MODEL=openai/gpt-4o-mini + OPENAI_API_KEY=...
# For Azure OpenAI: GENERATOR_MODEL=azure/<deployment-name> + AZURE_API_BASE + AZURE_API_KEY + AZURE_API_VERSION
GENERATOR_MODEL=openai/gpt-4o-mini
GENERATOR_API_KEY=
AZURE_API_BASE=
AZURE_API_KEY=
AZURE_API_VERSION=2024-10-21

# Optional Offline >650-Page Clustering (App. A.4 & B.5)
CLUSTER_EMBEDDING_MODEL=text-embedding-3-small
CLUSTER_SUMMARY_MODEL=openai/gpt-4o-mini

# Structure Parser Settings
MAX_PASSAGE_CHARS=1200